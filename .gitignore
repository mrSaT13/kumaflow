# Зависимости
node_modules/
.pnp
.pnp.js
.pnpm-store/

# Лок-файл npm. Основной пакетный менеджер проекта — pnpm (pnpm-lock.yaml
# в репозитории), а npm ставит рядом свой package-lock.json. Два лок-файла
# в одном репозитории дают конфликт версий при установке, поэтому npm-лок
# остаётся локальным. Если проект сознательно переедет на npm — удали строку.
package-lock.json

# Мусор: виндовые ярлыки .lnk попадали в assets/tray (результат копирования,
# а не ресурс приложения).
*.lnk

# Сборка electron-vite (main/preload/renderer)
out/

# Временные файлы сборки (setup.ps1 уводит сюда TEMP/TMP, т.к. C: забит)
.build-tmp/

# Артефакты electron-builder (инсталляторы, unpacked)
dist/
release/
*.AppImage
*.deb
*.dmg
*.exe
*.msi
*.snap
*.tar.gz
latest*.yml

# Vite / TS
*.local
*.tsbuildinfo
vite.config.*.timestamp*

# Логи
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Тесты и coverage
coverage/
.nyc_output/
cypress/screenshots/
cypress/videos/
cypress/downloads/
test-results/

# Env (секреты только локально, в репо им не место)
.env
.env.*
!.env.example

# ОС и редакторы
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Временные файлы
*.tmp
*.temp
.cache/
.parcel-cache/

# Бэкапы файлов ( *.bak, *.2026-10-14.bak ) — мусор от правок, в репозитории
# им не место.
*.bak
*.bak.*

# Заметки сессий — локальные (как в репозитории мозга).
SESSION_CONTINUE_*.md

# Черновики и внешние референсы (шейдеры, сторонние моды) — только локально.
новое/
