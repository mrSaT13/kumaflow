{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* shadcn/ui */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "cy/*": ["./cypress/*"]
    },
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Старый typeRoots перекрывал резолв типов: cypress не находился,
       из-за чего глобалы cy/describe/it давали hundreds TS2304.
       node_modules нужен как корень для пакетов вроде cypress. */
    "typeRoots": ["./node_modules/@types", "./node_modules", "./src/types"],
    "types": ["node", "cypress"]
  },
  "include": [
    "src",
    "cypress",
    "electron/preload/types.ts",
    "vite.config.ts"
  ],
  "exclude": ["src/service/ml-wave-service(old).ts"],
  "references": []
}